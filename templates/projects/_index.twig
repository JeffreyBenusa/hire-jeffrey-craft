{% extends '_layouts/base' %}
{% set entries = craft.entries()
    .section('projects')
    .all() %}

{% block content %}
    {% cache %}
        <div class="bg-teal py-28">
            <article class="max-w-5xl mx-auto px-2">
                <header class="text-white">
                    <h1 class="text-3xl lg:text-5xl font-bold">
                        <span class="block">Diverse Challenges.</span>
                        <span class="block">Deep Expertise.</span>
                        <span class="block">Results That Scale.</span>
                    </h1>
                    <p class="mt-4 text-xl lg:text-2xl italic">
                        Leveraging a deep technical toolkit to deliver results that matter.
                    </p>
                </header>
                <section
                    class="mt-8 lg:mt-16 grid grid-cols-1 gap-x-8 gap-y-4 lg:grid-cols-2 max-lg:max-w-lg max-lg:mx-auto">
                    {% for project in entries %}
                        {% include 'projects/_partials/card' with { params: {
                            entry: project,
                            loading: loop.index <= 2 ? 'eager' : 'lazy'
                        }} %}
                    {% endfor %}
                </section>
            </article>
        </div>
    {% endcache %}


    <section class="bg-gray-dark text-white px-6 py-12">
        <div class="font-bold text-center p-8">
            <h2 class="text-3xl tracking-tight ">How Can I Help?</h2>
            <p>Ready to take the next step? Fill out the form below, and let’s connect.</p>
        </div>
        <div class="mx-auto max-w-3xl">
            {% include '_partials/form' %}
        </div>
    </section>
{% endblock %}

{% block structuredData %}
    {% set projects = craft.entries.section('projects').orderBy('dateUpdated desc').all() %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "{{ entry.url }}#webpage",
                "name": "{{ entry.title }}",
                "url": "{{ entry.url }}",
                "headline": "Featured Projects by Jeffrey Benusa",
                "about": [
                    {
                        "@type": "Thing",
                        "name": "Web Development"
                    },
                    {
                        "@type": "Thing",
                        "name": "Portfolio"
                    }
                ],
                "description": "{{ entry.description }}",
                "author": {
                  "@id": "{{ craft.hireJeffrey.schemaPersonUrl }}"
                },
                "publisher": {
                  "@id": "{{ craft.hireJeffrey.schemaPersonUrl }}"
                },

                "datePublished": "{{ entry.postDate|date('Y-m-d') }}",
                "dateModified": "{{ entry.dateUpdated|date('Y-m-d') }}",
                "inLanguage": "en",
                "mainEntity": {
                    "@type": "ItemList",
                    "numberOfItems": {{ projects | length }},
                    "itemListElement": [
                      {{ projects | map(project => '{ "@id": "' ~ project.url ~ '#code" }') | join(', ') | raw }}
                    ]
                    },
                    "mainEntityOfPage": {
                        "@type": "CreativeWork",
                        "@id": "{{ entry.url }}"
                    },
                    "hasPart": [
                      {{ projects | map(project => '{ "@type": "CreativeWork", "@id": "' ~ project.url ~ '", "name": "' ~ project.title ~ '" }') | join(', ') | raw }}
                    ]
                },{
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Home",
                        "item": "{{ siteUrl }}"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Projects",
                        "item": "{{ url('projects') }}"
                    }
                ]
            }
        ]
    }
    </script>
{% endblock %}
