{% extends '_layouts/base' %}

{% block content %}
    <div class="bg-teal-dark py-28">
        <article class="text-white">
            <header class="max-w-5xl mx-auto px-2 mb-12">
                <h1 class="text-5xl font-bold">
                    {{ entry.headline ?? entry.title }}
                </h1>
                {% if entry.subheadline %}
                    <p class="mt-4 text-2xl italic">
                        {{ entry.subheadline }}
                    </p>
                {% endif %}
            </header>
            <section class="max-w-5xl mx-auto px-2">
                {{ entry.richText }}
            </section>
        </article>
    </div>

    <section class="bg-gray-dark text-white px-6 py-12">
        <div class="font-bold text-center p-8">
            <h2 class="text-3xl tracking-tight ">How Can I Help?</h2>
            <p>Ready to take the next step? Fill out the form below, and let’s connect.</p>
        </div>
        <div class="mx-auto max-w-3xl">
            {% include '_partials/form' %}
        </div>
    </section>
{% endblock %}

{% block structuredData %}
    {% set skills = craft.categories()
        .group('skillsAndTechnology')
        .status('enabled')
        .all() %}

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Person",
                "@id": "{{ craft.hireJeffrey.schemaPersonUrl }}",
                "name": "Jeffrey Benusa",
                "url": "{{ siteUrl }}",
                "jobTitle": "Full-Stack Web Developer / Web Dev Manager",
                "description": "{{ globals.description }}",
                "image": {
                    "@type": "ImageObject",
                    "url": "{{ globals.selfImage.one().url({format:'webp', height:'600', width:'600'}) }}",
                    "caption": "Portrait of Jeffrey Benusa",
                    "height": 600,
                    "width": 600
                },
                "contactPoint": {
                  "@type": "ContactPoint",
                  "contactType": "General Inquiries",
                  "email": "mailto:jeff.benusa@gmail.com",
                  "availableLanguage": ["English"]
                },
                "sameAs": [
                    "https://www.linkedin.com/in/benusa/",
                    "https://github.com/JeffreyBenusa"
                ],
                "knowsAbout": [
                  {{ skills | map(tag => tag.title | json_encode) | join(', ') | raw }}
                ],
                "worksFor": {
                    "@type": "Organization",
                    "name": "Freelance / Open for Hire",
                    "sameAs": "{{ siteUrl }}"
                },
                "alumniOf": {
                    "@type": "EducationalOrganization",
                    "name": "Saint John's University (MN)",
                    "sameAs": "https://www.csbsju.edu/"
                }
            },{
                "@type": "WebPage",
                "@id": "{{ url('about-me#webpage') }}",
                "url": "{{ url('about-me') }}",
                "name": "About Jeffrey Benusa",
                "description": "{{ entry.description }}",
                "inLanguage": "en",
                "author": {
                  "@id": "{{ craft.hireJeffrey.schemaPersonUrl }}"
                },
                "publisher": {
                  "@id": "{{ craft.hireJeffrey.schemaPersonUrl }}"
                },
                "mainEntityOfPage": {
                    "@type": "WebPage",
                    "@id": "{{ url('about-me') }}"
                },
                "datePublished": "{{ entry.postDate|date('Y-m-d') }}",
                "dateModified": "{{ entry.dateUpdated|date('Y-m-d') }}"
            },{
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Home",
                        "item": "{{ siteUrl }}"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "About Me",
                        "item": "{{ url('about-me') }}"
                    }
                ]
            }
        ]
    }
    </script>
{% endblock %}