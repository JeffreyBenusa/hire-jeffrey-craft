{% extends '_layouts/base' %}

{% block content %}
    <div class="bg-teal-dark py-28">
        <article class="text-white">
            <header class="max-w-5xl mx-auto px-2 mb-12">
                <h1 class="text-5xl font-bold">
                    {{ entry.headline ?? entry.title }}
                </h1>
                {% if entry.subheadline %}
                    <p class="mt-4 text-2xl italic">
                        {{ entry.subheadline }}
                    </p>
                {% endif %}
            </header>
            <section class="max-w-5xl mx-auto px-2">
                {{ entry.richText }}
            </section>
        </article>
    </div>

    <section class="bg-gray-dark text-white px-6 py-12">
        <div class="font-bold text-center p-8">
            <h2 class="text-3xl tracking-tight ">How Can I Help?</h2>
            <p>Ready to take the next step? Fill out the form below, and let’s connect.</p>
        </div>
        <div class="mx-auto max-w-3xl">
            {% include '_partials/form' %}
        </div>
    </section>
{% endblock %}

{% block structuredData %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Person",
                    "@id": "https://hirejeffrey.com#jeffreybenusa",
                    "name": "Jeffrey Benusa",
                    "url": "https://hirejeffrey.com",
                    "jobTitle": "Full-Stack Developer",
                    "sameAs": [
                        "https://hirejeffrey.com",
                        "https://www.linkedin.com/in/benusa/"
                    ]
                },
                {
                    "@type": "WebPage",
                    "@id": "https://hirejeffrey.com/about-me#webpage",
                    "url": "https://hirejeffrey.com/about-me",
                    "name": "About Jeffrey Benusa",
                    "description": "Learn more about Jeffrey Benusa, a senior full-stack developer based in Nashville, TN, and his approach to building scalable, user-first digital solutions.",
                    "inLanguage": "en",
                    "author": {
                        "@id": "https://hirejeffrey.com#jeffreybenusa"
                    },
                    "publisher": {
                        "@id": "https://hirejeffrey.com#jeffreybenusa"
                    },
                    "mainEntityOfPage": {
                        "@type": "WebPage",
                        "@id": "https://hirejeffrey.com/about-me"
                    },
                    "datePublished": "2024-02-15",
                    "dateModified": "2025-03-31"
                },
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Home",
                            "item": "https://hirejeffrey.com"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "About Me",
                            "item": "https://hirejeffrey.com/about-me"
