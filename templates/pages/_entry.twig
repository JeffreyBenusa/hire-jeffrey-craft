{% extends '_layouts/base' %}

{% block content %}
    {% cache %}
        <div class="bg-teal-dark py-28">
            <article class="text-white">
                <header class="max-w-5xl mx-auto px-2 mb-12">
                    <h1 class="text-6xl font-bold">
                        {{ entry.headline ?? entry.title }}
                    </h1>
                    {% if entry.subheadline %}
                        <p class="mt-4 text-2xl italic">
                            {{ entry.subheadline }}
                        </p>
                    {% endif %}
                </header>
                <section class="max-w-5xl mx-auto px-2">
                    {{ entry.richText }}
                </section>
            </article>
        </div>
    {% endcache %}

    <section class="bg-gray-dark text-white px-6 py-12">
        <div class="font-bold text-center p-8">
            <h2 class="text-3xl tracking-tight ">How Can I Help?</h2>
            <p>Ready to take the next step? Fill out the form below, and let’s connect.</p>
        </div>
        <div class="mx-auto max-w-3xl">
            {% include '_partials/form' %}
        </div>
    </section>
{% endblock %}

{% block structuredData %}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "WebPage",
                    "name": "{{ entry.title }}",
                    "url": "{{ entry.url }}",
                    "description": "{{ entry.description }}",
                    "author": {
                        "@type": "Person",
                        "name": "Jeffrey Benusa",
                        "url": "{{ siteUrl }}"
                    },
                    "publisher": {
                        "@type": "Person",
                        "name": "Jeffrey Benusa",
                        "url": "{{ siteUrl }}"
                    },
                    "datePublished": "{{ entry.postDate|date('Y-m-d') }}",
                    "dateModified": "{{ entry.dateUpdated|date('Y-m-d') }}",
                    "inLanguage": "en",
                    "mainEntityOfPage": {
                        "@type": "WebPage",
                        "@id": "{{ entry.url }}"
                    }
                },{
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        {
                            "@type": "ListItem",
                            "position": 1,
                            "name": "Home",
                            "item": "{{ siteUrl }}"
                        },
                        {
                            "@type": "ListItem",
                            "position": 2,
                            "name": "{{ entry.title }}",
                            "item": "{{ entry.url }}"
                        }
                    ]
                }
            ]
        }
    </script>
{% endblock %}