# Root-level configuration
root = true

# General settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Specific settings for Markdown files
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Specific settings for JSON files
[*.json]
indent_size = 2

# Specific settings for YAML files
[*.yml]
indent_size = 2

# Specific settings for PHP files
[*.php]
indent_size = 4
php_version = 8.3

# Specific settings for JavaScript and TypeScript files
[*.{js,ts}]
indent_size = 2

# Specific settings for CSS, SCSS, and HTML files
[*.{css,scss,html}]
indent_size = 2

# Specific settings for Makefiles
[Makefile]
indent_style = tab